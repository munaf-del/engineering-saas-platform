  barDiameter    Float   @map("bar_diameter")
  nominalArea    Float   @map("nominal_area")
  massPerMetre   Float   @map("mass_per_metre")
  grade          String
  ductilityClass String  @map("ductility_class")
  standardRef    String? @map("standard_ref")
  isDemo         Boolean @default(false) @map("is_demo")

  catalog RebarCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, designation])
  @@map("rebar_sizes")
}

// ─── Import Subsystem ─────────────────────────────────────────────

model ImportJob {
  id              String       @id @default(uuid()) @db.Uuid
  organisationId  String       @map("organisation_id") @db.Uuid
  entityType      String       @map("entity_type")
  format          ImportFormat
  fileName        String       @map("file_name")
  status          ImportStatus @default(pending)
  totalRows       Int          @default(0) @map("total_rows")
  validRows       Int          @default(0) @map("valid_rows")
  errorRows       Int          @default(0) @map("error_rows")
  dryRun          Boolean      @default(false) @map("dry_run")
  snapshotId      String?      @map("snapshot_id") @db.Uuid
  diff            Json?
  createdBy       String       @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  completedAt     DateTime?    @map("completed_at")
  rolledBackAt    DateTime?    @map("rolled_back_at")
  rolledBackBy    String?      @map("rolled_back_by") @db.Uuid
  approvedAt      DateTime?    @map("approved_at")
  approvedBy      String?      @map("approved_by") @db.Uuid
  rejectedAt      DateTime?    @map("rejected_at")
  rejectedBy      String?      @map("rejected_by") @db.Uuid
  rejectionReason String?      @map("rejection_reason")

  organisation Organisation      @relation(fields: [organisationId], references: [id])
  errors       ImportItemError[]
  approvals    ImportApproval[]

  @@index([organisationId, createdAt])
  @@map("import_jobs")
}

enum ImportFormat {
  csv
  xlsx
  json
  yaml
}

enum ImportStatus {
  pending
  validating
  validated
  awaiting_approval
  approved
  rejected
  applying
  applied
  rolling_back
  rolled_back
  failed
}

model ImportItemError {
  id          String              @id @default(uuid()) @db.Uuid
  importJobId String              @map("import_job_id") @db.Uuid
  rowNumber   Int                 @map("row_number")
  field       String?
  message     String
  severity    ImportErrorSeverity @default(error)

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_item_errors")
}

enum ImportErrorSeverity {
  error
  warning
}

model ImportApproval {
  id          String   @id @default(uuid()) @db.Uuid
  importJobId String   @map("import_job_id") @db.Uuid
  action      String
  reason      String?
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_approvals")
}

model RulePackActivation {
  id            String    @id @default(uuid()) @db.Uuid
  rulePackId    String    @map("rule_pack_id") @db.Uuid
  importJobId   String?   @map("import_job_id") @db.Uuid
  activatedBy   String    @map("activated_by") @db.Uuid
  activatedAt   DateTime  @default(now()) @map("activated_at")
  deactivatedAt DateTime? @map("deactivated_at")
  deactivatedBy String?   @map("deactivated_by") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  note          String?

  rulePack StandardRulePack @relation(fields: [rulePackId], references: [id])

  @@index([rulePackId])
  @@map("rule_pack_activations")
}

// ─── Documents ────────────────────────────────────────────────────

model Document {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  name           String
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  storagePath    String   @map("storage_path")
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([organisationId])
  @@index([projectId])
  @@map("documents")
}

enum AiDocumentKind {
  engineering_report
}

enum AiDocumentStatus {
  uploaded_local
  indexing
  indexed
  extracting
  extracted
  index_failed
  extraction_failed
}

enum AiReportDocumentFamily {
  geotechnical
  environmental
  structural
  hydrogeology_dewatering
  inspections
  temporary_works
  other
}

enum AiReportType {
  geotechnical_investigation
  geotechnical_comment
  dewatering_management_plan
  contamination_assessment
  structural_design_report
  inspection_report
  temporary_works_report
  other
}

enum AiReportOwnerWorkspace {
  project
  project_geotechnical
  foundations
  structural
  environmental
  inspections
  other
}

model AiDocument {
  id                  String                 @id @default(uuid()) @db.Uuid
  organisationId      String                 @map("organisation_id") @db.Uuid
  projectId           String                 @map("project_id") @db.Uuid
  pileGroupId         String?                @map("pile_group_id") @db.Uuid
  kind                AiDocumentKind         @default(engineering_report)
  documentFamily      AiReportDocumentFamily @default(other) @map("document_family")
  reportType          AiReportType           @default(other) @map("report_type")
  ownerWorkspace      AiReportOwnerWorkspace @default(project) @map("owner_workspace")
  filename            String
  mimeType            String                 @map("mime_type")
  storagePath         String                 @map("storage_path")
  openaiFileId        String?                @map("openai_file_id")
  openaiVectorStoreId String?                @map("openai_vector_store_id")
  status              AiDocumentStatus       @default(uploaded_local)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  organisation                      Organisation                              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                           Project                                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pileGroup                         PileGroup?                                @relation(fields: [pileGroupId], references: [id], onDelete: SetNull)
  extractionRuns                    AiExtractionRun[]
  cnvmpReferences                   ProjectCnvmpReference[]
  environmentalMonitoringReferences ProjectEnvironmentalMonitoringReference[]
  wasteClassificationReferences     ProjectWasteClassificationReference[]
  spatialFeatures                   ProjectSpatialFeature[]

  @@index([organisationId])
  @@index([projectId, createdAt])
  @@index([pileGroupId])
  @@map("ai_documents")
}

enum AiExtractionRunStatus {
  pending
  completed
  failed
}

model AiExtractionRun {
  id          String                @id @default(uuid()) @db.Uuid
  documentId  String                @map("document_id") @db.Uuid
  model       String
  status      AiExtractionRunStatus @default(pending)
  requestJson Json                  @map("request_json")
  resultJson  Json?                 @map("result_json")
  createdAt   DateTime              @default(now()) @map("created_at")

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("ai_extraction_runs")
}

// ─── Load Cases ──────────────────────────────────────────────────

enum LoadCategory {
  permanent
  imposed
  wind
  earthquake
  liquid_pressure
  earth_pressure
  thermal
}

model LoadCase {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  name        String
  category    LoadCategory
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions LoadAction[]

  @@map("load_cases")
}

enum LoadActionDirection {
  fx
  fy
  fz
  mx
  my
  mz
}

model LoadAction {
  id         String              @id @default(uuid()) @db.Uuid
  loadCaseId String              @map("load_case_id") @db.Uuid
  name       String
  direction  LoadActionDirection
  magnitude  Float
  unit       String
  metadata   Json                @default("{}")
  createdAt  DateTime            @default(now()) @map("created_at")

  loadCase LoadCase @relation(fields: [loadCaseId], references: [id], onDelete: Cascade)

  @@map("load_actions")
}

// ─── Load Combination Sets ───────────────────────────────────────

enum LimitState {
  strength
  serviceability
  stability
}

model LoadCombinationSet {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  standardRef String?  @map("standard_ref")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  combinations LoadCombination[]

  @@map("load_combination_sets")
}

model LoadCombination {
  id         String     @id @default(uuid()) @db.Uuid
  setId      String     @map("set_id") @db.Uuid
  name       String
  limitState LimitState @map("limit_state")
  clauseRef  String?    @map("clause_ref")
  factors    Json

  set LoadCombinationSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@map("load_combinations")
}

// ─── Calculator Registry ─────────────────────────────────────────

enum CalculatorStatus {
  draft
  active
  deprecated
}

model CalculatorDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  calcType    String   @map("calc_type")
  description String?
  category    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions CalculatorVersion[]

  @@map("calculator_definitions")
}

model CalculatorVersion {
  id            String           @id @default(uuid()) @db.Uuid
  definitionId  String           @map("definition_id") @db.Uuid
  version       String
  inputSchema   Json             @map("input_schema")
  outputSchema  Json?            @map("output_schema")
  defaultInputs Json?            @map("default_inputs")
  status        CalculatorStatus @default(draft)
  releaseNotes  String?          @map("release_notes")
  createdAt     DateTime         @default(now()) @map("created_at")

  definition      CalculatorDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  calculationRuns CalculationRun[]

  @@unique([definitionId, version])
  @@map("calculator_versions")
}

// ─── Calculations ─────────────────────────────────────────────────

model CalculationRun {
  id                  String     @id @default(uuid()) @db.Uuid
  projectId           String     @map("project_id") @db.Uuid
  elementId           String?    @map("element_id") @db.Uuid
  calculatorVersionId String?    @map("calculator_version_id") @db.Uuid
  calcType            String     @map("calc_type")
  status              CalcStatus @default(draft)
  requestSnapshot     Json       @map("request_snapshot")
  resultSnapshot      Json?      @map("result_snapshot")
  requestHash         String     @map("request_hash")
  durationMs          Int?       @map("duration_ms")
  notes               String?
  createdBy           String     @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  element           Element?             @relation(fields: [elementId], references: [id])
  calculatorVersion CalculatorVersion?   @relation(fields: [calculatorVersionId], references: [id])
  creator           User                 @relation(fields: [createdBy], references: [id])
  snapshot          CalculationSnapshot?
  reports           CalculationReport[]
  designChecks      PileDesignCheck[]

  @@index([projectId])
  @@index([requestHash])
  @@map("calculation_runs")
}

enum CalcStatus {
  draft
  running
  completed
  failed
  superseded
}

// ─── Calculation Snapshots (immutable) ────────────────────────────

model CalculationSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  calculationRunId  String   @unique @map("calculation_run_id") @db.Uuid
  inputSnapshot     Json     @map("input_snapshot")
  inputHash         String   @map("input_hash")
  standardsSnapshot Json     @map("standards_snapshot")
  standardsHash     String   @map("standards_hash")
  rulePackSnapshot  Json     @map("rule_pack_snapshot")
  rulePackHash      String   @map("rule_pack_hash")
  outputSnapshot    Json?    @map("output_snapshot")
  outputHash        String?  @map("output_hash")
  combinedHash      String   @map("combined_hash")
  createdAt         DateTime @default(now()) @map("created_at")

  calculationRun CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)

  @@index([combinedHash])
  @@map("calculation_snapshots")
}

// ─── Calculation Reports ─────────────────────────────────────────

enum ReportStatus {
  draft
  generating
  completed
  failed
}

model CalculationReport {
  id               String       @id @default(uuid()) @db.Uuid
  calculationRunId String       @map("calculation_run_id") @db.Uuid
  projectId        String       @map("project_id") @db.Uuid
  title            String
  format           String       @default("json")
  status           ReportStatus @default(draft)
  evidenceBundle   Json?        @map("evidence_bundle")
  generatedBy      String       @map("generated_by") @db.Uuid
  generatedAt      DateTime?    @map("generated_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  calculationRun CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("calculation_reports")
}

// ─── Pile Groups & Piles ─────────────────────────────────────────

enum PileType {
  bored
  driven
  cfa
  micropile
  screw
}

model PileGroup {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  description String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  piles        Pile[]
  layoutPoints PileLayoutPoint[]
  designChecks PileDesignCheck[]
  aiDocuments  AiDocument[]

  @@map("pile_groups")
}

model Pile {
  id             String   @id @default(uuid()) @db.Uuid
  pileGroupId    String   @map("pile_group_id") @db.Uuid
  name           String
  pileType       PileType @map("pile_type")
  diameter       Float
  length         Float
  embedmentDepth Float?   @map("embedment_depth")
  rakeAngle      Float?   @map("rake_angle")
  materialId     String?  @map("material_id") @db.Uuid
  properties     Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pileGroup        PileGroup             @relation(fields: [pileGroupId], references: [id], onDelete: Cascade)
  layoutPoints     PileLayoutPoint[]
  capacityProfiles PileCapacityProfile[]
  designChecks     PileDesignCheck[]

  @@map("piles")
}

model PileLayoutPoint {
  id          String  @id @default(uuid()) @db.Uuid
  pileGroupId String  @map("pile_group_id") @db.Uuid
  pileId      String? @map("pile_id") @db.Uuid
  x           Float
  y           Float
  z           Float   @default(0)
  label       String?

  pileGroup PileGroup @relation(fields: [pileGroupId], references: [id], onDelete: Cascade)
  pile      Pile?     @relation(fields: [pileId], references: [id])

  @@map("pile_layout_points")
}

// ─── Pile Capacity Profiles ──────────────────────────────────────

model PileCapacityProfile {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  pileId        String?  @map("pile_id") @db.Uuid
  soilProfileId String?  @map("soil_profile_id") @db.Uuid
  method        String
  standardRef   String?  @map("standard_ref")
  parameters    Json
  inputSnapshot Json     @map("input_snapshot")
  inputHash     String   @map("input_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pile    Pile?   @relation(fields: [pileId], references: [id])

  @@map("pile_capacity_profiles")
}

// ─── Pile Design Checks ──────────────────────────────────────────

enum DesignCheckStatus {
  pass
  fail
  warning
  not_checked
}

model PileDesignCheck {
  id               String            @id @default(uuid()) @db.Uuid
  calculationRunId String            @map("calculation_run_id") @db.Uuid
  pileId           String?           @map("pile_id") @db.Uuid
  pileGroupId      String?           @map("pile_group_id") @db.Uuid
  checkType        String            @map("check_type")
  limitState       LimitState        @map("limit_state")
  demandValue      Float             @map("demand_value")
  capacityValue    Float             @map("capacity_value")
  utilisationRatio Float             @map("utilisation_ratio")
  status           DesignCheckStatus
  clauseRef        String?           @map("clause_ref")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")

  calculationRun CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  pile           Pile?          @relation(fields: [pileId], references: [id])
  pileGroup      PileGroup?     @relation(fields: [pileGroupId], references: [id])

  @@map("pile_design_checks")
}

// ─── Refresh Tokens ──────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Audit ────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])

  @@index([organisationId, createdAt])
  @@map("audit_logs")
}
