generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenancy root ───────────────────────────────────────────

model Organisation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  abn       String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members                      OrganisationMember[]
  projects                     Project[]
  materials                    Material[]
  standardsProfiles            StandardsProfile[]
  auditLogs                    AuditLog[]
  geotechParameterSets         GeotechParameterSet[]
  steelSectionCatalogs         SteelSectionCatalog[]
  rebarCatalogs                RebarCatalog[]
  importJobs                   ImportJob[]
  documents                    Document[]
  aiDocuments                  AiDocument[]
  assistantProviderCredentials OrganisationAiAssistantProviderCredential[]
  rootSheetTemplates           RootSheetTemplate[]
  omnidotsProviderConnections  OmnidotsProviderConnection[]
  monitoringSeries             MonitoringSeries[]
  monitoringImportJobs         MonitoringImportJob[]

  @@map("organisations")
}

model OrganisationAiAssistantProviderCredential {
  id              String   @id @default(uuid()) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  provider        String   @db.VarChar(32)
  encryptedSecret Json     @map("encrypted_secret")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, provider])
  @@map("organisation_ai_assistant_provider_credentials")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orgMemberships     OrganisationMember[]
  projectMemberships ProjectMember[]
  calculationRuns    CalculationRun[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]

  @@map("users")
}

model OrganisationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@map("organisation_members")
}

enum OrgRole {
  owner
  admin
  engineer
  viewer
}

// ─── Projects ─────────────────────────────────────────────────────

model Project {
  id                 String        @id @default(uuid()) @db.Uuid
  organisationId     String        @map("organisation_id") @db.Uuid
  name               String
  code               String
  description        String?
  status             ProjectStatus @default(active)
  standardsProfileId String?       @map("standards_profile_id") @db.Uuid
  metadata           Json          @default("{}")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  organisation                   Organisation                           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  standardsProfile               StandardsProfile?                      @relation(fields: [standardsProfileId], references: [id])
  members                        ProjectMember[]
  elements                       Element[]
  calculationRuns                CalculationRun[]
  standardAssignments            ProjectStandardAssignment[]
  documents                      Document[]
  loadCases                      LoadCase[]
  loadCombinationSets            LoadCombinationSet[]
  pileGroups                     PileGroup[]
  pileCapacityProfiles           PileCapacityProfile[]
  reports                        CalculationReport[]
  aiDocuments                    AiDocument[]
  cnvmp                          ProjectCnvmp?
  environmentalMonitoringReports ProjectEnvironmentalMonitoringReport[]
  wasteClassificationReports     ProjectWasteClassificationReport[]
  spatialFeatures                ProjectSpatialFeature[]
  spatialViews                   ProjectSpatialView[]
  spatialSheets                  ProjectSpatialSheet[]
  draftingDrawings               DraftingDrawing[]
  draftingRevisions              DraftingRevision[]

  @@unique([organisationId, code])
  @@map("projects")
}

enum ProjectStatus {
  active
  on_hold
  completed
  archived
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

enum ProjectRole {
  lead
  engineer
  reviewer
  viewer
}

// ─── Elements ─────────────────────────────────────────────────────

model Element {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  elementType String   @map("element_type")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  calculationRuns CalculationRun[]

  @@map("elements")
}

// ─── Standards ────────────────────────────────────────────────────

model Standard {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  title     String
  category  StandardCategory
  isDemo    Boolean          @default(false) @map("is_demo")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  editions StandardEdition[]

  @@map("standards")
}

enum StandardCategory {
  loading
  concrete
  steel
  reinforcement
  geotech
  general
}

model StandardEdition {
  id              String         @id @default(uuid()) @db.Uuid
  standardId      String         @map("standard_id") @db.Uuid
  code            String
  title           String
  edition         String
  amendment       String?
  sourceEdition   String         @map("source_edition")
  sourceAmendment String?        @map("source_amendment")
  clauseRef       String?        @map("clause_ref")
  note            String?
  sourceDoc       String?        @map("source_doc")
  effectiveDate   DateTime       @map("effective_date")
  status          StandardStatus @default(current)
  isDemo          Boolean        @default(false) @map("is_demo")
  rulePackId      String?        @map("rule_pack_id") @db.Uuid

  standard           Standard                    @relation(fields: [standardId], references: [id], onDelete: Cascade)
  rulePack           StandardRulePack?           @relation(fields: [rulePackId], references: [id])
  clauseRefs         StandardClauseRef[]
  pinnedStandards    PinnedStandard[]
  projectAssignments ProjectStandardAssignment[]

  @@unique([code, edition])
  @@map("standard_editions")
}

enum StandardStatus {
  current
  superseded
  withdrawn
}

model StandardRulePack {
  id           String   @id @default(uuid()) @db.Uuid
  standardCode String   @map("standard_code")
  version      String
  contentHash  String   @map("content_hash")
  rules        Json
  isDemo       Boolean  @default(false) @map("is_demo")
  importedBy   String   @map("imported_by")
  importedAt   DateTime @default(now()) @map("imported_at")

  standardEditions StandardEdition[]
  activations      RulePackActivation[]

  @@unique([standardCode, version])
  @@map("rule_packs")
}

model StandardClauseRef {
  id                String  @id @default(uuid()) @db.Uuid
  standardEditionId String  @map("standard_edition_id") @db.Uuid
  clause            String
  title             String
  description       String?
  isDemo            Boolean @default(false) @map("is_demo")

  standardEdition StandardEdition @relation(fields: [standardEditionId], references: [id], onDelete: Cascade)

  @@unique([standardEditionId, clause])
  @@map("standard_clause_refs")
}

model StandardsProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  description    String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  pinnedStandards PinnedStandard[]
  projects        Project[]

  @@map("standards_profiles")
}

model PinnedStandard {
  id                 String @id @default(uuid()) @db.Uuid
  standardsProfileId String @map("standards_profile_id") @db.Uuid
  standardEditionId  String @map("standard_edition_id") @db.Uuid

  standardsProfile StandardsProfile @relation(fields: [standardsProfileId], references: [id], onDelete: Cascade)
  standardEdition  StandardEdition  @relation(fields: [standardEditionId], references: [id])

  @@unique([standardsProfileId, standardEditionId])
  @@map("pinned_standards")
}

model ProjectStandardAssignment {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  standardEditionId String   @map("standard_edition_id") @db.Uuid
  notes             String?
  pinnedAt          DateTime @default(now()) @map("pinned_at")
  pinnedBy          String   @map("pinned_by") @db.Uuid

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  standardEdition StandardEdition @relation(fields: [standardEditionId], references: [id])

  @@unique([projectId, standardEditionId])
  @@map("project_standard_assignments")
}

// ─── Noise & Vibration Standards Registry ────────────────────────

enum NoiseVibrationPublicationStatus {
  active
  draft_under_review
  superseded
}

enum NoiseVibrationLegalStatus {
  enforceable
  guidance_only
}

enum NoiseVibrationInstrumentType {
  statutory
  consent_condition
  guidance_only
  project_specific
}

enum NoiseVibrationCriterionCategory {
  working_hours
  airborne_noise_management
  ground_borne_noise
  vibration_human_comfort
  vibration_structural_damage
  blasting_airblast
  blasting_ground_vibration
  time_period_definition
}

enum NoiseVibrationMetric {
  laeq_15min
  lamax
  laf1_1min
  lin_peak
  ppv
  vdv
  none
}

enum NoiseVibrationValueBasis {
  absolute
  relative_to_rbl
  frequency_banded
  descriptive
}

enum NoiseVibrationReceiverType {
  residential
  heritage
  sensitive
  commercial
  industrial
  educational
  hospital
  place_of_worship
  active_recreation
  passive_recreation
  office_retail
  workshop
  critical_area
}

enum NoiseVibrationTimePeriod {
  day
  evening
  night
  standard_hours
  outside_standard_hours
  blasting_hours
  any
}

enum NoiseVibrationLocationBasis {
  property_boundary
  internal
  external
  occupied_point
  foundation
  uppermost_storey
  any
}

enum NoiseVibrationWorkType {
  general_construction
  bored_piling
  driven_piling
  rock_breaking
  blasting
  excavation
  dynamic_compaction
}

model NoiseVibrationStandardSource {
  id                String                          @id @default(uuid()) @db.Uuid
  slug              String                          @unique
  name              String
  shortName         String                          @map("short_name")
  publisher         String
  jurisdiction      String
  year              Int
  publicationStatus NoiseVibrationPublicationStatus @map("publication_status")
  legalStatus       NoiseVibrationLegalStatus       @map("legal_status")
  instrumentType    NoiseVibrationInstrumentType    @map("instrument_type")
  sourceCitation    String                          @map("source_citation")
  sourceUrl         String?                         @map("source_url")
  notes             String?
  isSeeded          Boolean                         @default(false) @map("is_seeded")
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")

  criterionGroups NoiseVibrationCriterionGroup[]
  cnvmpSelections ProjectCnvmpSelectedSource[]

  @@index([jurisdiction])
  @@index([publicationStatus])
  @@index([legalStatus])
  @@index([instrumentType])
  @@map("noise_vibration_standard_sources")
}

model NoiseVibrationCriterionGroup {
  id                String                          @id @default(uuid()) @db.Uuid
  standardSourceId  String                          @map("standard_source_id") @db.Uuid
  slug              String
  title             String
  criterionCategory NoiseVibrationCriterionCategory @map("criterion_category")
  metric            NoiseVibrationMetric
  locationBasis     NoiseVibrationLocationBasis?    @map("location_basis")
  description       String?
  sortOrder         Int                             @default(0) @map("sort_order")
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")

  standardSource NoiseVibrationStandardSource @relation(fields: [standardSourceId], references: [id], onDelete: Cascade)
  criterionRows  NoiseVibrationCriterionRow[]

  @@unique([standardSourceId, slug])
  @@index([criterionCategory])
  @@index([metric])
  @@map("noise_vibration_criterion_groups")
}

model NoiseVibrationCriterionRow {
  id                         String                      @id @default(uuid()) @db.Uuid
  criterionGroupId           String                      @map("criterion_group_id") @db.Uuid
  rowKey                     String                      @map("row_key")
  label                      String
  receiverType               NoiseVibrationReceiverType? @map("receiver_type")
  structureType              String?                     @map("structure_type")
  timePeriod                 NoiseVibrationTimePeriod?   @map("time_period")
  basisType                  NoiseVibrationValueBasis    @map("basis_type")
  referenceBase              String?                     @map("reference_base")
  relativeOffset             Decimal?                    @map("relative_offset") @db.Decimal(12, 3)
  criterionValue             Decimal?                    @map("criterion_value") @db.Decimal(12, 3)
  preferredValue             Decimal?                    @map("preferred_value") @db.Decimal(12, 3)
  maximumValue               Decimal?                    @map("maximum_value") @db.Decimal(12, 3)
  alertValue                 Decimal?                    @map("alert_value") @db.Decimal(12, 3)
  stopWorkValue              Decimal?                    @map("stop_work_value") @db.Decimal(12, 3)
  absoluteMaxValue           Decimal?                    @map("absolute_max_value") @db.Decimal(12, 3)
  valueMin                   Decimal?                    @map("value_min") @db.Decimal(12, 3)
  valueMax                   Decimal?                    @map("value_max") @db.Decimal(12, 3)
  frequencyMinHz             Decimal?                    @map("frequency_min_hz") @db.Decimal(12, 3)
  frequencyMaxHz             Decimal?                    @map("frequency_max_hz") @db.Decimal(12, 3)
  weekdayStart               String?                     @map("weekday_start")
  weekdayEnd                 String?                     @map("weekday_end")
  saturdayStart              String?                     @map("saturday_start")
  saturdayEnd                String?                     @map("saturday_end")
  sundayAllowed              Boolean?                    @map("sunday_allowed")
  publicHolidayAllowed       Boolean?                    @map("public_holiday_allowed")
  exceedanceAllowancePercent Decimal?                    @map("exceedance_allowance_percent") @db.Decimal(12, 3)
  exceedanceWindowText       String?                     @map("exceedance_window_text")
  unit                       String?
  sourceClause               String?                     @map("source_clause")
  rowNotes                   String?                     @map("row_notes")
  sortOrder                  Int                         @default(0) @map("sort_order")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  criterionGroup                    NoiseVibrationCriterionGroup                      @relation(fields: [criterionGroupId], references: [id], onDelete: Cascade)
  workTypes                         NoiseVibrationCriterionRowWorkType[]
  cnvmpSelections                   ProjectCnvmpSelectedCriterion[]
  environmentalMonitoringSelections ProjectEnvironmentalMonitoringSelectedCriterion[]
  environmentalNoiseResults         ProjectEnvironmentalNoiseResultRow[]
  environmentalVibrationResults     ProjectEnvironmentalVibrationResultRow[]

  @@unique([criterionGroupId, rowKey])
  @@index([receiverType])
  @@index([timePeriod])
  @@index([basisType])
  @@map("noise_vibration_criterion_rows")
}

model NoiseVibrationCriterionRowWorkType {
  criterionRowId String                 @map("criterion_row_id") @db.Uuid
  workType       NoiseVibrationWorkType @map("work_type")

  criterionRow NoiseVibrationCriterionRow @relation(fields: [criterionRowId], references: [id], onDelete: Cascade)

  @@id([criterionRowId, workType])
  @@index([workType])
  @@map("noise_vibration_criterion_row_work_types")
}

// ─── Project CNVMP Builder ───────────────────────────────────────

enum ProjectCnvmpSelectionPurpose {
  noise
  vibration_human_comfort
  vibration_structural
  blasting
  time_definition
  other
}

model ProjectCnvmp {
  id                         String    @id @default(uuid()) @db.Uuid
  projectId                  String    @unique @map("project_id") @db.Uuid
  title                      String?
  revision                   String?
  issueDate                  DateTime? @map("issue_date")
  preparedBy                 String?   @map("prepared_by")
  checkedBy                  String?   @map("checked_by")
  purpose                    String?
  documentStatus             String?   @map("document_status")
  client                     String?
  projectName                String?   @map("project_name")
  projectAddress             String?   @map("project_address")
  projectDescription         String?   @map("project_description")
  scopeOfWorks               String?   @map("scope_of_works")
  constructionActivitiesNote String?   @map("construction_activities_note")
  standardHoursNote          String?   @map("standard_hours_note")
  outOfHoursNote             String?   @map("out_of_hours_note")
  sensitiveReceiversNote     String?   @map("sensitive_receivers_note")
  communityCommunicationNote String?   @map("community_communication_note")
  contactDetailsNote         String?   @map("contact_details_note")
  complaintsHandlingNote     String?   @map("complaints_handling_note")
  respiteCommunicationNote   String?   @map("respite_communication_note")
  assumptionsLimitations     String?   @map("assumptions_limitations")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  project          Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  references       ProjectCnvmpReference[]
  receivers        ProjectCnvmpReceiver[]
  activities       ProjectCnvmpActivity[]
  selectedSources  ProjectCnvmpSelectedSource[]
  selectedCriteria ProjectCnvmpSelectedCriterion[]
  mitigationRows   ProjectCnvmpMitigationMeasure[]
  monitoringRows   ProjectCnvmpMonitoringRow[]

  @@map("project_cnvmps")
}

model ProjectCnvmpReference {
  id                 String  @id @default(uuid()) @db.Uuid
  projectCnvmpId     String  @map("project_cnvmp_id") @db.Uuid
  projectReferenceId String? @map("project_reference_id")
  aiDocumentId       String? @map("ai_document_id") @db.Uuid
  label              String?
  note               String?
  sortOrder          Int     @default(0) @map("sort_order")

  projectCnvmp ProjectCnvmp @relation(fields: [projectCnvmpId], references: [id], onDelete: Cascade)
  aiDocument   AiDocument?  @relation(fields: [aiDocumentId], references: [id], onDelete: SetNull)

  @@index([projectCnvmpId, sortOrder])
  @@index([aiDocumentId])
  @@map("project_cnvmp_references")
}

model ProjectCnvmpReceiver {
  id                      String                       @id @default(uuid()) @db.Uuid
  projectCnvmpId          String                       @map("project_cnvmp_id") @db.Uuid
  label                   String
  receiverType            NoiseVibrationReceiverType   @map("receiver_type")
  locationDescription     String?                      @map("location_description")
  distanceNote            String?                      @map("distance_note")
  sensitivityNote         String?                      @map("sensitivity_note")
  usePeriodNote           String?                      @map("use_period_note")
  isHeritage              Boolean                      @default(false) @map("is_heritage")
  isCritical              Boolean                      @default(false) @map("is_critical")
  assessmentLocationBasis NoiseVibrationLocationBasis? @map("assessment_location_basis")
  sortOrder               Int                          @default(0) @map("sort_order")

  projectCnvmp ProjectCnvmp @relation(fields: [projectCnvmpId], references: [id], onDelete: Cascade)

  @@index([projectCnvmpId, sortOrder])
  @@index([receiverType])
  @@map("project_cnvmp_receivers")
}

model ProjectCnvmpActivity {
  id                     String                 @id @default(uuid()) @db.Uuid
  projectCnvmpId         String                 @map("project_cnvmp_id") @db.Uuid
  label                  String
  workType               NoiseVibrationWorkType @map("work_type")
  description            String?
  timingNote             String?                @map("timing_note")
  isOutsideStandardHours Boolean                @default(false) @map("is_outside_standard_hours")
  noiseRiskNote          String?                @map("noise_risk_note")
  vibrationRiskNote      String?                @map("vibration_risk_note")
  sortOrder              Int                    @default(0) @map("sort_order")

  projectCnvmp ProjectCnvmp @relation(fields: [projectCnvmpId], references: [id], onDelete: Cascade)

  @@index([projectCnvmpId, sortOrder])
  @@index([workType])
  @@map("project_cnvmp_activities")
}

model ProjectCnvmpSelectedSource {
  id                         String  @id @default(uuid()) @db.Uuid
  projectCnvmpId             String  @map("project_cnvmp_id") @db.Uuid
  standardSourceId           String  @map("standard_source_id") @db.Uuid
  isGuidanceOnly             Boolean @default(true) @map("is_guidance_only")
  isEnforceableOnThisProject Boolean @default(false) @map("is_enforceable_on_this_project")
  projectConditionReference  String? @map("project_condition_reference")
  selectionNote              String? @map("selection_note")
  sortOrder                  Int     @default(0) @map("sort_order")

  projectCnvmp   ProjectCnvmp                 @relation(fields: [projectCnvmpId], references: [id], onDelete: Cascade)
  standardSource NoiseVibrationStandardSource @relation(fields: [standardSourceId], references: [id])

  @@unique([projectCnvmpId, standardSourceId])
  @@index([projectCnvmpId, sortOrder])
  @@index([standardSourceId])
  @@map("project_cnvmp_selected_sources")
}

model ProjectCnvmpSelectedCriterion {
  id                         String                       @id @default(uuid()) @db.Uuid
  projectCnvmpId             String                       @map("project_cnvmp_id") @db.Uuid
  criterionRowId             String                       @map("criterion_row_id") @db.Uuid
  selectionPurpose           ProjectCnvmpSelectionPurpose @map("selection_purpose")
  isEnforceableOnThisProject Boolean                      @default(false) @map("is_enforceable_on_this_project")
  projectConditionReference  String?                      @map("project_condition_reference")
  selectionNote              String?                      @map("selection_note")
  sortOrder                  Int                          @default(0) @map("sort_order")

  projectCnvmp ProjectCnvmp               @relation(fields: [projectCnvmpId], references: [id], onDelete: Cascade)
  criterionRow NoiseVibrationCriterionRow @relation(fields: [criterionRowId], references: [id])

  @@unique([projectCnvmpId, criterionRowId, selectionPurpose])
  @@index([projectCnvmpId, sortOrder])
  @@index([criterionRowId])
  @@map("project_cnvmp_selected_criteria")
}

model ProjectCnvmpMitigationMeasure {
  id             String  @id @default(uuid()) @db.Uuid
  projectCnvmpId String  @map("project_cnvmp_id") @db.Uuid
  category       String
  measure        String
  triggerNote    String? @map("trigger_note")
  responsibility String?
  timingStage    String? @map("timing_stage")
  note           String?
  sortOrder      Int     @default(0) @map("sort_order")

  projectCnvmp ProjectCnvmp @relation(fields: [projectCnvmpId], references: [id], onDelete: Cascade)

  @@index([projectCnvmpId, sortOrder])
  @@map("project_cnvmp_mitigation_measures")
}

model ProjectCnvmpMonitoringRow {
  id             String  @id @default(uuid()) @db.Uuid
  projectCnvmpId String  @map("project_cnvmp_id") @db.Uuid
  parameter      String
  method         String?
  location       String?
  frequency      String?
  triggerAction  String? @map("trigger_action")
  responsibility String?
  reportingNote  String? @map("reporting_note")
  sortOrder      Int     @default(0) @map("sort_order")

  projectCnvmp ProjectCnvmp @relation(fields: [projectCnvmpId], references: [id], onDelete: Cascade)

  @@index([projectCnvmpId, sortOrder])
  @@map("project_cnvmp_monitoring_rows")
}

// ─── Environmental Monitoring Reports ────────────────────────────

enum ProjectEnvironmentalMonitoringReportType {
  noise_monitoring
  vibration_monitoring
}

enum ProjectEnvironmentalMonitoringComplianceStatus {
  not_assessed
  compliant
  trigger_exceeded
  criterion_exceeded
  not_applicable
  complies
  exceeds
  review_required
}

enum ProjectEnvironmentalMonitoringCriterionApplicabilityStatus {
  applicable
  reference_only
  superseded_by_project_condition
  not_applicable
}

enum ProjectEnvironmentalMonitoringMetricType {
  ppv
  vdv
  lin_peak
  other
}

enum ProjectEnvironmentalMonitoringAnnexureType {
  spatial_sheet
}

enum MonitoringProviderKey {
  omnidots
}

enum MonitoringProviderConnectionStatus {
  pending
  active
  invalid
  disabled
  error
}

enum MonitoringProviderAuthType {
  api_token
}

enum MonitoringImportJobType {
  validate_token
  sync_measuring_points
  import_peak_records
